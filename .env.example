# SurrealDB connection (used by the Rust server)
SURREALDB_ADDRESS=localhost:8000
SURREALDB_NAMESPACE=escrow
SURREALDB_DATABASE=wallet

# SurrealDB root credentials (dev only — set real values in .env)
SURREAL_USER=root
SURREAL_PASS=root

# JWT signing secret (dev only — change in production)
JWT_SECRET=dev-secret-key
